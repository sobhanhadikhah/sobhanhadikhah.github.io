# Apache / cPanel configuration for the static export.
# Upload this file together with the rest of `out/` into public_html/.

Options -Indexes
DirectoryIndex index.html

# Custom 404 page generated by Next.js
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Uncomment to force HTTPS once your SSL certificate is active:
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Uncomment to redirect www -> non-www (replace example.com):
  # RewriteCond %{HTTP_HOST} ^www\.example\.com$ [NC]
  # RewriteRule ^ https://example.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Security headers (previously in next.config.mjs)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# The generated Open Graph image has no file extension
<Files "opengraph-image">
  ForceType image/png
</Files>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml font/ttf font/woff2
</IfModule>

# Caching: hashed build assets under /_next/static/ never change -> cache forever.
# Other files (your photo, favicon, ...) get a shorter cache so replacements show up.
# HTML/XML must always revalidate so new deploys are picked up immediately.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(png|jpe?g|webp|avif|gif|svg|ico|ttf|woff2?)$#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#(\.html|\.xml|\.txt|/)$#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </ElseIf>
</IfModule>
